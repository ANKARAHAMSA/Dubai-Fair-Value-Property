# Optional Dubai Pulse API credentials (only needed for API pull; manual CSV download in data/raw/ works without these)
DUBAI_PULSE_API_KEY=
DUBAI_PULSE_API_SECRET=

# Optional LLM configuration for natural-language search (app works offline via deterministic rules fallback)
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest

# API configuration
DFV_API_HOST=127.0.0.1
DFV_API_PORT=8000
DFV_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Data mode override (auto | sample | processed)
DFV_DATA_MODE=auto
